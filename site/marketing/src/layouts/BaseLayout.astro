---
import ConsentBanner from "@components/ConsentBanner.astro";
import {
  content,
  externalLinks,
  localizedAlternates,
  localeNames,
  navItems,
  pageFor,
  routeFor,
  type Locale,
  type PageKey
} from "@data/site";

const { locale, pageKey } = Astro.props as { locale: Locale; pageKey: PageKey };
const page = pageFor(locale, pageKey);
const copy = content[locale];
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const withBase = (path: string) => `${basePath}${path}`.replace(/\/{2,}/g, "/");
const canonical = new URL(withBase(routeFor(pageKey, locale)), Astro.site).toString();
const alternates = localizedAlternates(pageKey).map(({ locale: altLocale, href }) => ({
  locale: altLocale,
  href: new URL(withBase(href), Astro.site).toString()
}));
const otherLocale: Locale = locale === "en" ? "fi" : "en";
const ui = {
  en: {
    skip: "Skip to content",
    language: "Language",
    docs: "Docs",
    github: "GitHub",
    menu: "Menu",
    footerTagline: "Self-hosted release evidence for software vendors.",
    footerBoundary:
      "Evydence is not a legal compliance service, certification authority, vulnerability scanner, hosted SaaS, or guarantee of release security.",
    cookiePreferences: "Cookie preferences"
  },
  fi: {
    skip: "Siirry sisältöön",
    language: "Kieli",
    docs: "Dokumentaatio",
    github: "GitHub",
    menu: "Valikko",
    footerTagline: "Itse ylläpidettävä julkaisuevidence ohjelmistotoimittajille.",
    footerBoundary:
      "Evydence ei ole juridinen vaatimustenmukaisuuspalvelu, sertifiointitaho, haavoittuvuusskanneri, hostattu SaaS-palvelu tai takuu julkaisun turvallisuudesta.",
    cookiePreferences: "Evästeasetukset"
  }
}[locale];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{page.metaTitle}</title>
    <meta name="description" content={page.description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.locale} href={alternate.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(withBase(routeFor("home", "en")), Astro.site).toString()} />
    <meta property="og:title" content={page.metaTitle} />
    <meta property="og:description" content={page.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
  </head>
  <body>
    <a class="skip-link" href="#main">{ui.skip}</a>
    <header class="site-header">
      <a class="brand" href={withBase(routeFor("home", locale))} aria-label="Evydence">
        <span class="brand__mark" aria-hidden="true">E</span>
        <span>Evydence</span>
      </a>
      <nav class="nav" aria-label="Primary">
        {navItems.map((item) => (
          <a href={withBase(routeFor(item, locale))} aria-current={item === pageKey ? "page" : undefined}>
            {copy[item].navTitle}
          </a>
        ))}
        <a href={externalLinks.docs} data-track="docs_click">{ui.docs}</a>
      </nav>
      <div class="header-actions" aria-label={ui.language}>
        <a class="language-link" href={withBase(routeFor(pageKey, otherLocale))} data-track="language_switch">
          {localeNames[otherLocale]}
        </a>
        <a class="button button--small" href={externalLinks.linkedin} data-track="contact_click">
          {copy.contact.navTitle}
        </a>
      </div>
      <details class="mobile-nav">
        <summary>{ui.menu}</summary>
        <div class="mobile-nav__panel">
          {navItems.map((item) => (
            <a href={withBase(routeFor(item, locale))} aria-current={item === pageKey ? "page" : undefined}>
              {copy[item].navTitle}
            </a>
          ))}
          <a href={externalLinks.docs} data-track="docs_click">{ui.docs}</a>
          <a href={withBase(routeFor(pageKey, otherLocale))} data-track="language_switch">
            {localeNames[otherLocale]}
          </a>
          <a href={externalLinks.linkedin} data-track="contact_click">
            {copy.contact.navTitle}
          </a>
        </div>
      </details>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div>
        <strong>Evydence</strong>
        <p>{ui.footerTagline}</p>
        <p class="boundary">{ui.footerBoundary}</p>
      </div>
      <nav aria-label="Footer">
        <a href={withBase(routeFor("product", locale))}>{copy.product.navTitle}</a>
        <a href={withBase(routeFor("commercial", locale))}>{copy.commercial.navTitle}</a>
        <a href={withBase(routeFor("status", locale))}>{copy.status.navTitle}</a>
        <a href={externalLinks.github} data-track="github_click">{ui.github}</a>
        <a href={externalLinks.docs} data-track="docs_click">{ui.docs}</a>
        <a href={withBase(routeFor("privacyCookies", locale))}>{copy.privacyCookies.navTitle}</a>
        <button type="button" data-cookie-preferences>{ui.cookiePreferences}</button>
      </nav>
    </footer>
    <ConsentBanner locale={locale} />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --bg: #f7f6f1;
    --surface: #ffffff;
    --surface-2: #eeece3;
    --ink: #171814;
    --muted: #5d6258;
    --line: #d8d5c7;
    --accent: #0f7c69;
    --accent-dark: #075948;
    --accent-soft: #dceee9;
    --warn: #7c3f13;
    --radius: 8px;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: var(--bg);
    color: var(--ink);
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    min-width: 320px;
    line-height: 1.5;
  }

  a {
    color: inherit;
  }

  :focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
  }

  .skip-link {
    left: 1rem;
    position: fixed;
    top: 1rem;
    transform: translateY(-160%);
    z-index: 20;
    background: var(--ink);
    color: white;
    padding: 0.65rem 0.9rem;
    border-radius: var(--radius);
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .site-header {
    align-items: center;
    display: grid;
    gap: 1rem;
    grid-template-columns: auto 1fr auto;
    padding: 1rem clamp(1rem, 4vw, 3rem);
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(247, 246, 241, 0.94);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--line);
  }

  .brand,
  .nav,
  .header-actions,
  .site-footer nav,
  .mobile-nav__panel {
    align-items: center;
    display: flex;
    gap: 0.8rem;
  }

  .brand,
  .nav a,
  .header-actions a,
  .mobile-nav a,
  .site-footer a,
  .site-footer button {
    text-decoration: none;
  }

  .brand {
    font-weight: 750;
    letter-spacing: 0;
  }

  .brand__mark {
    align-items: center;
    background: var(--ink);
    border-radius: 6px;
    color: white;
    display: inline-flex;
    height: 2rem;
    justify-content: center;
    width: 2rem;
  }

  .nav {
    flex-wrap: wrap;
    justify-content: center;
  }

  .nav a,
  .language-link,
  .mobile-nav a {
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.94rem;
    padding: 0.45rem 0.65rem;
  }

  .nav a:hover,
  .nav a[aria-current="page"],
  .language-link:hover,
  .mobile-nav a:hover,
  .mobile-nav a[aria-current="page"] {
    background: var(--surface-2);
    color: var(--ink);
  }

  .mobile-nav {
    display: none;
    position: relative;
  }

  .mobile-nav summary {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--ink);
    cursor: pointer;
    font-weight: 750;
    list-style: none;
    min-height: 2.4rem;
    padding: 0.52rem 0.85rem;
  }

  .mobile-nav summary::-webkit-details-marker {
    display: none;
  }

  .mobile-nav__panel {
    align-items: stretch;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: 0 1rem 2.5rem rgba(0, 0, 0, 0.16);
    flex-direction: column;
    gap: 0.25rem;
    margin-top: 0.5rem;
    padding: 0.45rem;
    position: absolute;
    right: 0;
    width: min(22rem, calc(100vw - 2rem));
  }

  .mobile-nav a {
    border-radius: 6px;
  }

  .button {
    align-items: center;
    border: 1px solid var(--ink);
    border-radius: var(--radius);
    display: inline-flex;
    font-weight: 700;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.75rem 1rem;
    text-decoration: none;
    transition: transform 160ms ease, background 160ms ease;
  }

  .button:hover {
    transform: translateY(-1px);
  }

  .button--solid {
    background: var(--ink);
    color: white;
  }

  .button--ghost {
    background: transparent;
    color: var(--ink);
  }

  .button--text {
    background: transparent;
    border-color: transparent;
    color: var(--muted);
  }

  .button--small {
    min-height: 2.3rem;
    padding: 0.45rem 0.75rem;
  }

  .hero,
  .section,
  .site-footer {
    padding-left: clamp(1rem, 4vw, 3rem);
    padding-right: clamp(1rem, 4vw, 3rem);
  }

  .hero {
    align-items: center;
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
    grid-template-columns: minmax(0, 1.08fr) minmax(18rem, 0.92fr);
    min-height: min(760px, calc(100vh - 4.8rem));
    padding-bottom: clamp(2rem, 4vw, 3rem);
    padding-top: clamp(2.8rem, 6vw, 5rem);
  }

  .hero__content {
    max-width: 58rem;
  }

  .eyebrow {
    color: var(--accent-dark);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    font-size: clamp(2.55rem, 4.65vw, 4.65rem);
    hyphens: auto;
    line-height: 1.02;
    letter-spacing: 0;
    margin-bottom: 1.15rem;
    max-width: 16.5ch;
    overflow-wrap: break-word;
  }

  h2 {
    font-size: clamp(2rem, 4.5vw, 4rem);
    hyphens: auto;
    line-height: 1.02;
    letter-spacing: 0;
    max-width: 13ch;
    overflow-wrap: anywhere;
  }

  .hero h1 {
    hyphens: none;
    overflow-wrap: normal;
    text-wrap: balance;
    word-break: normal;
  }

  :lang(fi) h1 {
    font-size: clamp(2.15rem, 3.55vw, 3.45rem);
    max-width: 22ch;
  }

  :lang(fi) h2 {
    font-size: clamp(1.8rem, 2.9vw, 2.75rem);
    max-width: 100%;
  }

  h3 {
    font-size: 1.1rem;
    letter-spacing: 0;
  }

  .lede {
    color: var(--muted);
    font-size: clamp(1.08rem, 2vw, 1.28rem);
    max-width: 46rem;
  }

  .hero__actions,
  .section__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.5rem;
  }

  .hero__demo {
    align-items: center;
    color: var(--muted);
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.65rem;
    margin: 1.15rem 0 0;
    max-width: 42rem;
  }

  .hero__demo span {
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--ink);
    font-size: 0.78rem;
    font-weight: 800;
    padding: 0.2rem 0.55rem;
    text-transform: uppercase;
  }

  .hero__demo a {
    color: var(--accent-dark);
    font-weight: 800;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.22em;
  }

  .hero__demo small {
    font-size: 0.94rem;
  }

  .section {
    padding-bottom: clamp(3rem, 7vw, 6rem);
    padding-top: clamp(3rem, 7vw, 6rem);
  }

  .section--split {
    border-top: 1px solid var(--line);
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }

  .section--split h2 {
    max-width: 100%;
  }

  :lang(fi) .section--split h2 {
    font-size: clamp(1.75rem, 2.55vw, 2.45rem);
  }

  .hero__content,
  .section--split > *,
  .section__body,
  .table-row > * {
    min-width: 0;
  }

  .section__body {
    color: var(--muted);
    font-size: 1.05rem;
    max-width: 45rem;
  }

  .bullet-grid,
  .card-grid {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    padding: 0;
  }

  .bullet-grid li,
  .card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    list-style: none;
    padding: 1rem;
  }

  .table-list {
    display: grid;
    gap: 0.75rem;
  }

  .table-row {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr 1fr;
    padding: 1rem;
  }

  .table-row span:first-child {
    color: var(--muted);
  }

  .table-row span:last-child {
    font-weight: 750;
  }

  .site-footer {
    background: var(--ink);
    color: white;
    display: grid;
    gap: 2rem;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    padding-bottom: 2rem;
    padding-top: 2rem;
  }

  .site-footer p {
    color: #d7d8d1;
    max-width: 46rem;
  }

  .site-footer .boundary {
    color: #b9bbb2;
    font-size: 0.92rem;
  }

  .site-footer nav {
    align-content: start;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .site-footer a,
  .site-footer button {
    background: transparent;
    border: 0;
    color: white;
    cursor: pointer;
    font: inherit;
    padding: 0.35rem;
  }

  .consent {
    bottom: 1rem;
    left: 1rem;
    position: fixed;
    right: 1rem;
    z-index: 30;
  }

  .consent__content {
    align-items: end;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: 0 1.5rem 4rem rgba(0, 0, 0, 0.18);
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr auto;
    margin: 0 auto;
    max-width: 64rem;
    padding: 1rem;
  }

  .consent h2 {
    font-size: 1.1rem;
    margin-bottom: 0.25rem;
  }

  .consent p {
    color: var(--muted);
    margin-bottom: 0;
  }

  .consent__note {
    font-size: 0.88rem;
    margin-top: 0.45rem;
  }

  .consent__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: flex-end;
  }

  @media (max-width: 900px) {
    .site-header,
    .hero,
    .section--split,
    .site-footer,
    .consent__content {
      grid-template-columns: 1fr;
    }

    .site-header {
      grid-template-columns: auto auto;
      justify-content: space-between;
    }

    .nav,
    .header-actions {
      display: none;
    }

    .mobile-nav {
      display: block;
      justify-self: end;
    }

    .site-footer nav {
      justify-content: flex-start;
    }

    .hero {
      min-height: auto;
      padding-top: 2.5rem;
    }

    h1,
    h2 {
      max-width: none;
    }

    h1 {
      font-size: clamp(2.45rem, 12vw, 4rem);
    }

    :lang(fi) h1 {
      font-size: 1.85rem;
      line-height: 1.08;
    }

    :lang(fi) h2 {
      font-size: 1.95rem;
      line-height: 1.08;
    }

    .bullet-grid,
    .card-grid,
    .table-row {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
      transition: none !important;
    }
  }
</style>
