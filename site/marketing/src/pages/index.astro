---
import { routeFor } from "@data/site";

const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const withBase = (path: string) => `${basePath}${path}`.replace(/\/{2,}/g, "/");
const englishUrl = withBase(routeFor("home", "en"));
const finnishUrl = withBase(routeFor("home", "fi"));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0; url=${englishUrl}`} />
    <link rel="canonical" href={englishUrl} />
    <title>Evydence</title>
    <style>
      :root {
        color: #18221f;
        font-family:
          Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }

      body {
        align-items: center;
        background: #f6f2e9;
        display: grid;
        margin: 0;
        min-height: 100vh;
        padding: 2rem;
      }

      main {
        max-width: 36rem;
      }

      h1 {
        font-size: clamp(2rem, 8vw, 4rem);
        line-height: 1;
        margin: 0 0 1rem;
      }

      p {
        color: #51625b;
        font-size: 1.1rem;
        line-height: 1.6;
        margin: 0 0 1.5rem;
      }

      a {
        color: #145c4a;
        font-weight: 700;
        margin-right: 1rem;
      }
    </style>
  </head>
  <body>
    <main>
      <h1>Evydence</h1>
      <p>English is the default language. Continue to the English site, or switch to Finnish.</p>
      <a href={englishUrl}>Continue in English</a>
      <a href={finnishUrl} hreflang="fi">Suomeksi</a>
    </main>
  </body>
</html>
