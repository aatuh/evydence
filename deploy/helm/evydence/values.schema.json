{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["api", "worker", "cleanupTimeoutSeconds", "env", "migration"],
  "properties": {
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "timeoutSeconds",
        "allowLegacyHistory",
        "existingSecret",
        "secretSource",
        "resources"
      ],
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 248,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 900
        },
        "allowLegacyHistory": {
          "type": "boolean"
        },
        "runtimeRole": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^[^\u0000-\u001f\u007f-\u009f]*$"
        },
        "existingSecret": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
        },
        "secretSource": {
          "type": "string",
          "enum": [
            "env",
            "files"
          ]
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "existingSecret": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"},
    "cleanupTimeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 60},
    "api": {
      "type": "object",
      "required": [
        "replicas",
        "shutdownTimeoutSeconds",
        "terminationGracePeriodSeconds",
        "readHeaderTimeoutSeconds",
        "readTimeoutSeconds",
        "writeTimeoutSeconds",
        "idleTimeoutSeconds",
        "maxHeaderBytes",
        "maxURLBytes",
        "maxInFlightRequests",
        "maxConcurrentUploads",
        "rateLimitRequestsPerMinute",
        "authenticationFailuresPerMinute",
        "expensiveTenantRequestsPerMinute",
        "rateLimitBucketCapacity",
        "secretSource",
        "environmentSecret",
        "secretFiles"
      ],
      "properties": {
        "existingSecret": {"type": "string", "maxLength": 253, "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"},
        "replicas": {"type": "integer", "const": 1},
        "writerMode": {"type": "string", "enum": ["single", "single-writer"]},
        "readHeaderTimeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 60},
        "readTimeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 900},
        "writeTimeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 900},
        "idleTimeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "maxHeaderBytes": {"type": "integer", "minimum": 1024, "maximum": 1048576},
        "maxURLBytes": {"type": "integer", "minimum": 1024, "maximum": 65536},
        "maxInFlightRequests": {"type": "integer", "minimum": 1, "maximum": 100000},
        "maxConcurrentUploads": {"type": "integer", "minimum": 1, "maximum": 10000},
        "rateLimitRequestsPerMinute": {"type": "integer", "minimum": 0, "maximum": 60000},
        "authenticationFailuresPerMinute": {"type": "integer", "minimum": 1, "maximum": 60000},
        "expensiveTenantRequestsPerMinute": {"type": "integer", "minimum": 0, "maximum": 60000},
        "rateLimitBucketCapacity": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "shutdownTimeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 300},
        "terminationGracePeriodSeconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "secretSource": {"type": "string", "enum": ["env", "files"]},
        "environmentSecret": {"type": "string", "maxLength": 253, "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"},
        "secretFiles": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "EVYDENCE_S3_ACCESS_KEY_ID_FILE": {"$ref": "#/definitions/secretKey"},
            "EVYDENCE_S3_SECRET_ACCESS_KEY_FILE": {"$ref": "#/definitions/secretKey"},
            "EVYDENCE_SIGNING_EXECUTOR_TOKEN_FILE": {"$ref": "#/definitions/secretKey"},
            "EVYDENCE_PROVIDER_VALIDATION_GATEWAY_TOKEN_FILE": {"$ref": "#/definitions/secretKey"},
            "EVYDENCE_TRANSPARENCY_PROOF_GATEWAY_TOKEN_FILE": {"$ref": "#/definitions/secretKey"}
          }
        }
      }
    },
    "worker": {
      "type": "object",
      "required": [
        "replicas",
        "shutdownTimeoutSeconds",
        "terminationGracePeriodSeconds",
        "healthPort",
        "probes",
        "secretSource",
        "environmentSecret",
        "secretFiles"
      ],
      "properties": {
        "existingSecret": {"type": "string", "maxLength": 253, "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"},
        "healthPort": {"type": "integer", "minimum": 1, "maximum": 65535},
        "probes": {
          "type": "object",
          "required": ["enabled", "startupCommand", "readinessCommand", "livenessCommand"],
          "properties": {
            "enabled": {"type": "boolean"},
            "startupCommand": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "readinessCommand": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "livenessCommand": {"type": "array", "minItems": 1, "items": {"type": "string"}}
          }
        },
        "replicas": {"type": "integer", "minimum": 0},
        "shutdownTimeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 300},
        "terminationGracePeriodSeconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "secretSource": {"type": "string", "enum": ["env", "files"]},
        "environmentSecret": {"type": "string", "maxLength": 253, "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"},
        "secretFiles": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "EVYDENCE_S3_ACCESS_KEY_ID_FILE": {"$ref": "#/definitions/secretKey"},
            "EVYDENCE_S3_SECRET_ACCESS_KEY_FILE": {"$ref": "#/definitions/secretKey"}
          }
        }
      }
    },
    "env": {
      "type": "object",
      "required": ["databaseURLSecretKey", "apiKeyPepperSecretKey"],
      "properties": {
        "databaseURLSecretKey": {"$ref": "#/definitions/secretKey"},
        "apiKeyPepperSecretKey": {"$ref": "#/definitions/secretKey"}
      }
    },
    "podSecurityContext": {
      "type": "object",
      "properties": {
        "fsGroup": {"type": "integer", "minimum": 1, "maximum": 4294967294}
      }
    }
  },
  "definitions": {
    "secretKey": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[A-Za-z0-9._-]+$"}
  }
}
