{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["api", "worker", "cleanupTimeoutSeconds", "env", "migration", "image", "scratchSizeMi", "podSecurityContext", "containerSecurityContext", "networkPolicy"],
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest", "pullPolicy", "pullSecrets"],
      "properties": {
        "repository": {"type": "string", "minLength": 1, "maxLength": 255, "pattern": "^(?:[A-Za-z0-9]|\\[)[A-Za-z0-9._:/\\[\\]-]*$"},
        "tag": {"type": "string", "pattern": "^(?:$|[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}(?:@sha256:[a-f0-9]{64})?)$"},
        "digest": {"type": "string", "pattern": "^(?:$|sha256:[a-f0-9]{64})$"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]},
        "pullSecrets": {
          "type": "array", "maxItems": 16, "uniqueItems": true,
          "items": {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {
            "name": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"}
          }}
        }
      }
    },
    "scratchSizeMi": {"type": "integer", "minimum": 1, "maximum": 1024},
    "networkPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "apiIngressFrom", "dnsPeers", "apiEgress", "workerEgress", "migrationEgress"],
      "properties": {
        "enabled": {"type": "boolean"},
        "apiIngressFrom": {"$ref": "#/definitions/networkPeers"},
        "dnsPeers": {"$ref": "#/definitions/networkPeers"},
        "apiEgress": {"$ref": "#/definitions/networkEgress"},
        "workerEgress": {"$ref": "#/definitions/networkEgress"},
        "migrationEgress": {"$ref": "#/definitions/networkEgress"}
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "timeoutSeconds",
        "allowLegacyHistory",
        "existingSecret",
        "secretSource",
        "resources"
      ],
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 248,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 900
        },
        "allowLegacyHistory": {
          "type": "boolean"
        },
        "runtimeRole": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^[^\u0000-\u001f\u007f-\u009f]*$"
        },
        "existingSecret": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
        },
        "secretSource": {
          "type": "string",
          "enum": [
            "env",
            "files"
          ]
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "existingSecret": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"},
    "cleanupTimeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 60},
    "api": {
      "type": "object",
      "required": [
        "replicas",
        "shutdownTimeoutSeconds",
        "terminationGracePeriodSeconds",
        "readHeaderTimeoutSeconds",
        "readTimeoutSeconds",
        "writeTimeoutSeconds",
        "idleTimeoutSeconds",
        "maxHeaderBytes",
        "maxURLBytes",
        "maxInFlightRequests",
        "maxConcurrentUploads",
        "rateLimitRequestsPerMinute",
        "authenticationFailuresPerMinute",
        "expensiveTenantRequestsPerMinute",
        "rateLimitBucketCapacity",
        "secretSource",
        "environmentSecret",
        "secretFiles",
        "disruptionBudget"
      ],
      "properties": {
        "disruptionBudget": {"$ref": "#/definitions/disruptionBudget"},
        "serviceAccountAnnotations": {"$ref": "#/definitions/annotations"},
        "existingSecret": {"type": "string", "maxLength": 253, "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"},
        "replicas": {"type": "integer", "const": 1},
        "writerMode": {"type": "string", "enum": ["single", "single-writer"]},
        "readHeaderTimeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 60},
        "readTimeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 900},
        "writeTimeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 900},
        "idleTimeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "maxHeaderBytes": {"type": "integer", "minimum": 1024, "maximum": 1048576},
        "maxURLBytes": {"type": "integer", "minimum": 1024, "maximum": 65536},
        "maxInFlightRequests": {"type": "integer", "minimum": 1, "maximum": 100000},
        "maxConcurrentUploads": {"type": "integer", "minimum": 1, "maximum": 10000},
        "rateLimitRequestsPerMinute": {"type": "integer", "minimum": 0, "maximum": 60000},
        "authenticationFailuresPerMinute": {"type": "integer", "minimum": 1, "maximum": 60000},
        "expensiveTenantRequestsPerMinute": {"type": "integer", "minimum": 0, "maximum": 60000},
        "rateLimitBucketCapacity": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "shutdownTimeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 300},
        "terminationGracePeriodSeconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "secretSource": {"type": "string", "enum": ["env", "files"]},
        "environmentSecret": {"type": "string", "maxLength": 253, "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"},
        "secretFiles": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "EVYDENCE_S3_ACCESS_KEY_ID_FILE": {"$ref": "#/definitions/secretKey"},
            "EVYDENCE_S3_SECRET_ACCESS_KEY_FILE": {"$ref": "#/definitions/secretKey"},
            "EVYDENCE_SIGNING_EXECUTOR_TOKEN_FILE": {"$ref": "#/definitions/secretKey"},
            "EVYDENCE_PROVIDER_VALIDATION_GATEWAY_TOKEN_FILE": {"$ref": "#/definitions/secretKey"},
            "EVYDENCE_TRANSPARENCY_PROOF_GATEWAY_TOKEN_FILE": {"$ref": "#/definitions/secretKey"}
          }
        }
      }
    },
    "worker": {
      "type": "object",
      "required": [
        "replicas",
        "shutdownTimeoutSeconds",
        "terminationGracePeriodSeconds",
        "healthPort",
        "probes",
        "secretSource",
        "environmentSecret",
        "secretFiles",
        "disruptionBudget"
      ],
      "properties": {
        "disruptionBudget": {"$ref": "#/definitions/disruptionBudget"},
        "serviceAccountAnnotations": {"$ref": "#/definitions/annotations"},
        "existingSecret": {"type": "string", "maxLength": 253, "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"},
        "healthPort": {"type": "integer", "minimum": 1, "maximum": 65535},
        "probes": {
          "type": "object",
          "required": ["enabled", "startupCommand", "readinessCommand", "livenessCommand"],
          "properties": {
            "enabled": {"type": "boolean"},
            "startupCommand": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "readinessCommand": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "livenessCommand": {"type": "array", "minItems": 1, "items": {"type": "string"}}
          }
        },
        "replicas": {"type": "integer", "minimum": 0},
        "shutdownTimeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 300},
        "terminationGracePeriodSeconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "secretSource": {"type": "string", "enum": ["env", "files"]},
        "environmentSecret": {"type": "string", "maxLength": 253, "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"},
        "secretFiles": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "EVYDENCE_S3_ACCESS_KEY_ID_FILE": {"$ref": "#/definitions/secretKey"},
            "EVYDENCE_S3_SECRET_ACCESS_KEY_FILE": {"$ref": "#/definitions/secretKey"}
          }
        }
      }
    },
    "env": {
      "type": "object",
      "required": ["production", "objectStore", "databaseURLSecretKey", "apiKeyPepperSecretKey"],
      "properties": {
        "production": {"type": "boolean"},
        "objectStore": {"type": "string", "enum": ["s3", "filesystem"]},
        "databaseURLSecretKey": {"$ref": "#/definitions/secretKey"},
        "apiKeyPepperSecretKey": {"$ref": "#/definitions/secretKey"}
      }
    },
    "podSecurityContext": {
      "type": "object",
      "required": ["runAsNonRoot", "runAsUser", "runAsGroup", "seccompProfile"],
      "properties": {
        "runAsNonRoot": {"type": "boolean"},
        "runAsUser": {"type": "integer", "minimum": 0, "maximum": 4294967294},
        "runAsGroup": {"type": "integer", "minimum": 0, "maximum": 4294967294},
        "seccompProfile": {
          "type": "object", "required": ["type"],
          "properties": {"type": {"type": "string", "enum": ["RuntimeDefault", "Localhost", "Unconfined"]}, "localhostProfile": {"type": "string", "minLength": 1}},
          "allOf": [{"if": {"properties": {"type": {"const": "Localhost"}}}, "then": {"required": ["localhostProfile"]}}]
        },
        "fsGroup": {"type": "integer", "minimum": 1, "maximum": 4294967294}
      }
    },
    "containerSecurityContext": {
      "type": "object", "additionalProperties": false,
      "required": ["privileged", "allowPrivilegeEscalation", "readOnlyRootFilesystem", "capabilities"],
      "properties": {
        "privileged": {"type": "boolean"},
        "allowPrivilegeEscalation": {"type": "boolean"},
        "readOnlyRootFilesystem": {"type": "boolean"},
        "capabilities": {
          "type": "object", "additionalProperties": false, "required": ["drop"],
          "properties": {"add": {"type": "array", "items": {"type": "string"}}, "drop": {"type": "array", "items": {"type": "string"}, "minItems": 1}}
        }
      }
    }
  },
  "allOf": [{
    "if": {"properties": {"env": {"properties": {"production": {"const": true}}}}},
    "then": {"properties": {
      "env": {"properties": {"objectStore": {"const": "s3"}}},
      "podSecurityContext": {"properties": {"runAsNonRoot": {"const": true}, "runAsUser": {"minimum": 1}, "runAsGroup": {"minimum": 1}, "seccompProfile": {"properties": {"type": {"enum": ["RuntimeDefault", "Localhost"]}}}}},
      "containerSecurityContext": {"properties": {"privileged": {"const": false}, "allowPrivilegeEscalation": {"const": false}, "readOnlyRootFilesystem": {"const": true}, "capabilities": {"properties": {"add": {"maxItems": 0}, "drop": {"contains": {"const": "ALL"}}}}}}
    }}
  }],
  "definitions": {
    "disruptionBudget": {
      "type": "object", "additionalProperties": false, "required": ["enabled"],
      "properties": {"enabled": {"type": "boolean"}}
    },
    "networkPeers": {
      "type": "array", "maxItems": 64, "items": {"$ref": "#/definitions/networkPeer"}
    },
    "networkPeer": {
      "type": "object", "additionalProperties": false,
      "anyOf": [{"required": ["podSelector"]}, {"required": ["namespaceSelector"]}, {"required": ["ipBlock"]}],
      "not": {"allOf": [{"required": ["ipBlock"]}, {"anyOf": [{"required": ["podSelector"]}, {"required": ["namespaceSelector"]}]}]},
      "properties": {
        "podSelector": {"$ref": "#/definitions/networkSelector"},
        "namespaceSelector": {"$ref": "#/definitions/networkSelector"},
        "ipBlock": {
          "type": "object", "additionalProperties": false, "required": ["cidr"],
          "properties": {
            "cidr": {"type": "string", "minLength": 3, "maxLength": 64},
            "except": {"type": "array", "maxItems": 64, "items": {"type": "string", "minLength": 3, "maxLength": 64}}
          }
        }
      }
    },
    "networkSelector": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "matchLabels": {"type": "object", "maxProperties": 64, "additionalProperties": {"type": "string", "maxLength": 63}},
        "matchExpressions": {
          "type": "array", "maxItems": 64,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["key", "operator"],
            "properties": {
              "key": {"type": "string", "minLength": 1, "maxLength": 317},
              "operator": {"type": "string", "enum": ["In", "NotIn", "Exists", "DoesNotExist"]},
              "values": {"type": "array", "maxItems": 64, "items": {"type": "string", "maxLength": 63}}
            },
            "allOf": [{
              "if": {"properties": {"operator": {"enum": ["In", "NotIn"]}}},
              "then": {"required": ["values"], "properties": {"values": {"minItems": 1}}},
              "else": {"properties": {"values": {"maxItems": 0}}}
            }]
          }
        }
      }
    },
    "networkEgress": {
      "type": "array", "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["to", "ports"],
        "properties": {
          "to": {"allOf": [{"$ref": "#/definitions/networkPeers"}, {"minItems": 1}]},
          "ports": {
            "type": "array", "minItems": 1, "maxItems": 64,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["port"],
              "properties": {"port": {"type": "integer", "minimum": 1, "maximum": 65535}, "protocol": {"type": "string", "enum": ["TCP", "UDP", "SCTP"]}}
            }
          }
        }
      }
    },
    "annotations": {"type": "object", "maxProperties": 32, "additionalProperties": {"type": "string", "maxLength": 4096}},
    "secretKey": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[A-Za-z0-9._-]+$"}
  }
}
