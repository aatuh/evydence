                  "other": "Another certification",
                  "unknown": "The certification level is not known"
                }
              }
            },
            "mode": {
              "type": "string",
              "title": "Mode",
              "description": "The mode of operation in which the cryptographic algorithm (block cipher) is used.",
              "enum": [
                "cbc",
