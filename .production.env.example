# Evydence production environment example.
#
# Copy to an untracked deployment-specific file or translate these values into
# your secret manager, Kubernetes Secret, or sealed-secret workflow. Empty
# secret values are intentional: production startup should fail until an
# operator supplies real values. Do not commit rendered production values.

# Runtime diagnostics and ingress limits: docs/reference/observability.md and
# docs/reference/configuration.md. Keep edge/reverse-proxy limits as the primary
# control; process limits bound connection, parser, upload and route work before
# storage. Set trusted proxy CIDRs only for proxies that sanitize X-Forwarded-For.
#
# Worker metrics are optional; configure the address and a private credential
# file together. See docs/reference/observability.md#worker-scraping.
#
# Production examples select external S3/MinIO-compatible storage and external
# signing. Choose the signing profile and supply its required settings before
# startup. Do not use local plaintext signing-key storage in production.
# AWS KMS: EVYDENCE_SIGNING_KEY_MODE=aws-kms.
# GCP Cloud KMS: EVYDENCE_SIGNING_KEY_MODE=gcp-kms.
# Azure Key Vault: EVYDENCE_SIGNING_KEY_MODE=azure-key-vault.
#
# Sigstore/Cosign values are base64-encoded public trusted-root JSON or PEM
# public-key material, never private keys or tokens.
# Provider/transparency gateways are optional and require HTTPS in production.
# OIDC discovery and UserInfo HTTP overrides are for localhost tests only.
#
# Regenerate only the marked section with make config-generate; verify with
# make config-check. Keep real secrets outside the repository.

# BEGIN EVYDENCE GENERATED CONFIGURATION
# Generated from internal/platform/config schema metadata.
# Production examples are selections, not changes to runtime defaults.
# Required secrets are deliberately empty. Supply real values outside source control.

# Production-safety selector. Unset retains the non-production development profile.
# Type: choice; processes: API, worker, migration, online CLI, worker probe, parser replay, reconciliation; choices: unset, `development`, `staging`, `production`, `test`, `local`
ENV=production

# API bind address.
# Type: text; processes: API; schema validation
EVYDENCE_ADDR=:8080

# HMAC pepper for API key, session, and portal-token hashes. Use a long random value.
# Type: text; processes: API; schema validation
EVYDENCE_API_KEY_PEPPER=
# Unset EVYDENCE_API_KEY_PEPPER to use its private-file alternative instead:
# EVYDENCE_API_KEY_PEPPER_FILE=

# API writer concurrency mode. Production supports only `single` or `single-writer` until multi-writer concurrency controls are implemented.
# Type: choice; processes: API; choices: `single`, `single-writer`
EVYDENCE_API_WRITER_MODE=single

# Optional self-declared API writer replica count used by startup safety checks. Production rejects values other than `1`.
# Type: integer; processes: API; 1..9223372036854775807
EVYDENCE_API_WRITER_REPLICAS=1

# Per-client failure budget for each of credential authentication, public SSO, and portal access. Values must be 1 through 60000; zero cannot disable it. In-flight verification reserves budget until completion. See [failure limits](#authentication-and-portal-failure-limits-unreleased).
# Type: integer; processes: API; 1..60000
EVYDENCE_AUTH_FAILURES_PER_MINUTE=20

# Optional AWS KMS-compatible endpoint for tests or controlled private endpoints.
# Type: url; processes: API; endpoint policy: tls-base
EVYDENCE_AWS_KMS_ENDPOINT=

# AWS KMS asymmetric signing key id, alias, or ARN. Store IAM credentials outside Evydence config and logs.
# Type: text; processes: API; schema validation
EVYDENCE_AWS_KMS_KEY_ID=

# Supported values are `ECDSA_SHA_256`, `RSASSA_PSS_SHA_256`, and `RSASSA_PKCS1_V1_5_SHA_256` because Evydence signs stored SHA-256 payload hashes.
# Type: choice; processes: API; choices: `ECDSA_SHA_256`, `RSASSA_PSS_SHA_256`, `RSASSA_PKCS1_V1_5_SHA_256`
EVYDENCE_AWS_KMS_SIGNING_ALGORITHM=ECDSA_SHA_256

# Timeout for AWS KMS signing requests.
# Type: seconds; processes: API; 1..9223372036 seconds
EVYDENCE_AWS_KMS_TIMEOUT_SECONDS=10

# AWS signing region; the existing AWS_REGION fallback is an alias, not a second independent option.
# Type: text; processes: API; schema validation
EVYDENCE_AWS_REGION=

# Azure Key Vault signing algorithm used for the SHA-256 digest.
# Type: choice; processes: API; choices: `ES256`
EVYDENCE_AZURE_KEY_VAULT_ALGORITHM=ES256

# Azure Key Vault API version.
# Type: text; processes: API; schema validation
EVYDENCE_AZURE_KEY_VAULT_API_VERSION=7.4

# Default Key Vault key name required for metadata readiness. A signing provider `key_ref` URL can override it for actual signing.
# Type: text; processes: API; schema validation
EVYDENCE_AZURE_KEY_VAULT_KEY_NAME=

# Default Key Vault key version required for metadata readiness. A signing provider `key_ref` URL can override it for actual signing.
# Type: text; processes: API; schema validation
EVYDENCE_AZURE_KEY_VAULT_KEY_VERSION=

# Timeout for Azure Key Vault signing requests.
# Type: seconds; processes: API; 1..9223372036 seconds
EVYDENCE_AZURE_KEY_VAULT_TIMEOUT_SECONDS=10

# HTTPS Key Vault URL used by the direct Azure Key Vault executor.
# Type: url; processes: API; endpoint policy: tls-base
EVYDENCE_AZURE_KEY_VAULT_URL=

# Set to `true` to prevent startup bootstrap on an empty store.
# Type: boolean; processes: API; schema validation
EVYDENCE_BOOTSTRAP_DISABLED=true

# Tenant name used when bootstrapping an empty store; raw value must be valid UTF-8 without NUL bytes, at most 65,536 bytes, and nonblank after trimming.
# Type: text; processes: API; input bytes <= 65536
EVYDENCE_BOOTSTRAP_TENANT="Local Tenant"

# API/worker configuration revision: exactly 64 lowercase hexadecimal characters. Must match the projected revision file at startup and on subsequent cached health refreshes. This is an operator revision identifier, not evidence or a secret digest.
# Type: text; processes: API, worker; schema validation
EVYDENCE_CONFIGURATION_REVISION=

# Absolute path to an operator-owned local regular file containing the desired revision (at most 256 bytes, surrounding whitespace allowed). Symlinked projections must resolve inside the configured parent directory. Missing, invalid or changed content fails startup/readiness; no hot reload. See [configuration freshness](observability.md#configuration-freshness).
# Type: path; processes: API, worker; input bytes <= 4096
EVYDENCE_CONFIGURATION_REVISION_FILE=

# PostgreSQL durable state, projections, migrations, and persisted outbox jobs. Connection settings alone do not select the runtime profile.
# Type: postgres-dsn; processes: API, worker, migration, parser replay, reconciliation; schema validation
EVYDENCE_DATABASE_URL=
# Unset EVYDENCE_DATABASE_URL to use its private-file alternative instead:
# EVYDENCE_DATABASE_URL_FILE=

# Per-tenant, per-route limit for document ingestion, bundle/import/export, report/package generation, diffs, and policy evaluation. Set `0` only for controlled local evaluation.
# Type: integer; processes: API; 0..60000
EVYDENCE_EXPENSIVE_TENANT_REQUESTS_PER_MINUTE=30

# Optional GCP KMS endpoint for tests or controlled private endpoints.
# Type: url; processes: API; endpoint policy: tls-base
EVYDENCE_GCP_KMS_ENDPOINT=https://cloudkms.googleapis.com

# Default GCP Cloud KMS key version resource name. Required for the process's metadata readiness probe; a signing provider `key_ref` can still override it for actual signing.
# Type: text; processes: API; schema validation
EVYDENCE_GCP_KMS_KEY_NAME=

# Timeout for GCP KMS signing requests.
# Type: seconds; processes: API; 1..9223372036 seconds
EVYDENCE_GCP_KMS_TIMEOUT_SECONDS=10

# Idle keep-alive timeout. Values must be whole seconds from 1 through 3600.
# Type: seconds; processes: API; 1..3600 seconds
EVYDENCE_HTTP_IDLE_TIMEOUT_SECONDS=120

# Simultaneous native SBOM, VEX, scan, and OpenAPI-document upload cap. Saturation returns a retryable `429` Problem Details response.
# Type: integer; processes: API; 1..10000
EVYDENCE_HTTP_MAX_CONCURRENT_UPLOADS=8

# Listener header-size cap in bytes. Values must be 1024 through 1048576.
# Type: integer; processes: API; 1024..1048576
EVYDENCE_HTTP_MAX_HEADER_BYTES=16384

# Simultaneous ordinary application request cap. Saturation returns a retryable `429` Problem Details response. Canonical lifecycle probes use separate admission; see [observability](observability.md#endpoints).
# Type: integer; processes: API; 1..100000
EVYDENCE_HTTP_MAX_IN_FLIGHT_REQUESTS=256

# Raw request-target cap in bytes, including its query string. Values must be 1024 through 65536.
# Type: integer; processes: API; 1024..65536
EVYDENCE_HTTP_MAX_URL_BYTES=8192

# Maximum time to receive HTTP request headers. Values must be whole seconds from 1 through 60.
# Type: seconds; processes: API; 1..60 seconds
EVYDENCE_HTTP_READ_HEADER_TIMEOUT_SECONDS=5

# Maximum total request-read time. Values must be whole seconds from 1 through 900.
# Type: seconds; processes: API; 1..900 seconds
EVYDENCE_HTTP_READ_TIMEOUT_SECONDS=30

# Request drain budget after `SIGINT`, `SIGTERM`, or a permanent listener failure. Values must be whole seconds from 1 through 300.
# Type: seconds; processes: API; 1..300 seconds
EVYDENCE_HTTP_SHUTDOWN_TIMEOUT_SECONDS=30

# Maximum response-write time. Values must be whole seconds from 1 through 900.
# Type: seconds; processes: API; 1..900 seconds
EVYDENCE_HTTP_WRITE_TIMEOUT_SECONDS=60

# `json` or `text` (case-insensitive); both retain the same structured fields. Logs go to stderr; command results and explicitly requested local bootstrap credentials retain their separate stdout contract.
# Type: choice; processes: API, worker, migration, online CLI, worker probe, parser replay, reconciliation; choices: `json`, `text`
EVYDENCE_LOG_FORMAT=json

# API, worker and migration diagnostics: `debug`, `info`, `warn`, `error` (case-insensitive). Invalid values fail before dependency startup.
# Type: choice; processes: API, worker, migration, online CLI, worker probe, parser replay, reconciliation; choices: `debug`, `info`, `warn`, `error`
EVYDENCE_LOG_LEVEL=info

# Migration directory for API startup and `cmd/evydence-migrate`.
# Type: path; processes: API, worker, migration, parser replay, reconciliation; input bytes <= 4096
EVYDENCE_MIGRATIONS_DIR=migrations

# Local raw payload storage root.
# Type: path; processes: API, worker, parser replay, reconciliation; input bytes <= 4096
EVYDENCE_OBJECT_DIR=tmp/objects

# Supported values are `filesystem`, `s3`, and `minio`.
# Type: choice; processes: API, worker, parser replay, reconciliation; choices: `file`, `filesystem`, `s3`, `minio`
EVYDENCE_OBJECT_STORE=s3

# Allow HTTP loopback OIDC discovery only outside production.
# Type: boolean; processes: API; production-forbidden override
EVYDENCE_OIDC_DISCOVERY_ALLOW_INSECURE_LOCALHOST=false

# OIDC discovery timeout in whole seconds.
# Type: seconds; processes: API; 1..9223372036 seconds
EVYDENCE_OIDC_DISCOVERY_TIMEOUT_SECONDS=10

# Allows an HTTP loopback OIDC issuer/UserInfo endpoint only outside production. `ENV=production` rejects this setting when `true`. Discovery and UserInfo must remain the same origin, so a bearer token is never sent to a discovered different origin.
# Type: boolean; processes: API; production-forbidden override
EVYDENCE_OIDC_USERINFO_ALLOW_INSECURE_LOCALHOST=false

# Timeout for optional live OIDC UserInfo validation when `POST /v1/provider-verifications` includes `access_token`.
# Type: seconds; processes: API; 1..9223372036 seconds
EVYDENCE_OIDC_USERINFO_TIMEOUT_SECONDS=10

# Positive parser-replay command timeout; malformed explicit values fail before runtime opens.
# Type: duration; processes: parser replay; 1..9223372036854775807 nanoseconds
EVYDENCE_PARSER_REPLAY_TIMEOUT=2m

# PostgreSQL state load mode. Supported values are `snapshot_preferred`, `relational_preferred`, and `relational_only`. Production defaults to relational-only startup reads, refuses snapshot fallback modes, and disables compatibility snapshot writes; snapshots remain available for local compatibility and non-production migration checks.
# Type: choice; processes: API, worker, parser replay, reconciliation; choices: unset, `snapshot`, `snapshot_preferred`, `snapshot-preferred`, `relational`, `relational_preferred`, `relational-preferred`, `relational_only`, `relational-only`; production choices: unset, `relational_only`, `relational-only`
EVYDENCE_POSTGRES_LOAD_MODE=relational_only

# Prints the one-time bootstrap secret. Rejected when `ENV=production`.
# Type: boolean; processes: API; production-forbidden override
EVYDENCE_PRINT_BOOTSTRAP_SECRET=false

# Allows an HTTP loopback gateway only outside production. `ENV=production` rejects this setting when `true`.
# Type: boolean; processes: API; production-forbidden override
EVYDENCE_PROVIDER_VALIDATION_GATEWAY_ALLOW_INSECURE_LOCALHOST=false

# Timeout for provider validation gateway requests.
# Type: seconds; processes: API; 1..9223372036 seconds
EVYDENCE_PROVIDER_VALIDATION_GATEWAY_TIMEOUT_SECONDS=10

# Optional bearer token for the provider validation gateway. Store outside source control and logs.
# Type: text; processes: API; schema validation
EVYDENCE_PROVIDER_VALIDATION_GATEWAY_TOKEN=
# Unset EVYDENCE_PROVIDER_VALIDATION_GATEWAY_TOKEN to use its private-file alternative instead:
# EVYDENCE_PROVIDER_VALIDATION_GATEWAY_TOKEN_FILE=

# Optional HTTPS operator-controlled provider validation gateway. When set, provider verification uses this gateway instead of direct OIDC UserInfo calls.
# Type: url; processes: API; endpoint policy: gateway
EVYDENCE_PROVIDER_VALIDATION_GATEWAY_URL=

# Maximum tracked buckets per in-process limiter. Values must be 1 through 1000000. General client/tenant quotas evict least-recent buckets; failure quotas deny new keys while capacity is full, preserving active failure history.
# Type: integer; processes: API; 1..1000000
EVYDENCE_RATE_LIMIT_BUCKET_CAPACITY=10000

# In-process per-client request limit. Set `0` only for controlled local evaluation; retain a reverse-proxy or ingress limit as the primary edge control. Canonical lifecycle probes are excluded; see [observability](observability.md#endpoints).
# Type: integer; processes: API; 0..60000
EVYDENCE_RATE_LIMIT_REQUESTS_PER_MINUTE=120

# Positive object-reconciliation command timeout; malformed explicit values fail before runtime opens.
# Type: duration; processes: reconciliation; 1..9223372036854775807 nanoseconds
EVYDENCE_RECONCILIATION_TIMEOUT=10m

# The only supported runtime profile, including local evaluation. Retired `local_memory` input fails before opening resources and explains the PostgreSQL migration.
# Type: choice; processes: API, worker, parser replay, reconciliation; choices: `postgres`
EVYDENCE_RUNTIME_PROFILE=postgres

# Store outside source control.
# Type: text; processes: API, worker, parser replay, reconciliation; schema validation
EVYDENCE_S3_ACCESS_KEY_ID=
# Unset EVYDENCE_S3_ACCESS_KEY_ID to use its private-file alternative instead:
# EVYDENCE_S3_ACCESS_KEY_ID_FILE=

# Bucket must already exist. Names use the pinned MinIO SDK's basic S3 bucket grammar after trimming, including its 3 through 63 byte bound.
# Type: s3-bucket-name; processes: API, worker, parser replay, reconciliation; schema validation
EVYDENCE_S3_BUCKET=

# Endpoint for S3-compatible object storage.
# Type: url; processes: API, worker, parser replay, reconciliation; schema validation
EVYDENCE_S3_ENDPOINT=

# Optional S3 region.
# Type: text; processes: API, worker, parser replay, reconciliation; schema validation
EVYDENCE_S3_REGION=

# Store outside source control and logs.
# Type: text; processes: API, worker, parser replay, reconciliation; schema validation
EVYDENCE_S3_SECRET_ACCESS_KEY=
# Unset EVYDENCE_S3_SECRET_ACCESS_KEY to use its private-file alternative instead:
# EVYDENCE_S3_SECRET_ACCESS_KEY_FILE=

# Use TLS for remote object storage.
# Type: boolean; processes: API, worker, parser replay, reconciliation; schema validation
EVYDENCE_S3_USE_SSL=true

# API/worker resource-cleanup budget after draining or operator-command execution; whole seconds from 1 through 60. Invalid values fail before storage opens.
# Type: seconds; processes: API, worker, migration, parser replay, reconciliation; 1..60 seconds
EVYDENCE_SHUTDOWN_CLEANUP_TIMEOUT_SECONDS=5

# Allows an HTTP loopback signing gateway only outside production. `ENV=production` rejects this setting when `true`.
# Type: boolean; processes: API; production-forbidden override
EVYDENCE_SIGNING_EXECUTOR_ALLOW_INSECURE_LOCALHOST=false

# Required base64-encoded Ed25519 public key. Evydence verifies the gateway signature over the canonical signing-request hash before persisting a receipt. This is public trust material, never a private key.
# Type: base64; processes: API; decoded bytes <= 32
EVYDENCE_SIGNING_EXECUTOR_PUBLIC_KEY_BASE64=

# Explicit non-mutating GET endpoint on the signing URL's origin (same scheme, host and effective port), with no user information, query or fragment. Must return `200` with exactly `{"status":"ok"}` when required signing dependencies are available; responses are capped at 4096 bytes. Missing configuration keeps production readiness unavailable. Uses the signing bearer token and rejects redirects.
# Type: url; processes: API; endpoint policy: gateway-readiness
EVYDENCE_SIGNING_EXECUTOR_READINESS_URL=

# Timeout for signing gateway requests.
# Type: seconds; processes: API; 1..9223372036 seconds
EVYDENCE_SIGNING_EXECUTOR_TIMEOUT_SECONDS=10

# Optional bearer token for the signing gateway. Store outside source control and logs.
# Type: text; processes: API; schema validation
EVYDENCE_SIGNING_EXECUTOR_TOKEN=
# Unset EVYDENCE_SIGNING_EXECUTOR_TOKEN to use its private-file alternative instead:
# EVYDENCE_SIGNING_EXECUTOR_TOKEN_FILE=

# HTTPS signing gateway used by `POST /v1/signing-operations`. The API sends a canonical request that binds subject metadata and `payload_hash`, never raw payload bytes.
# Type: url; processes: API; endpoint policy: gateway
EVYDENCE_SIGNING_EXECUTOR_URL=

# Production rejects local plaintext signing-key mode. `aws-kms`, `gcp-kms`, and `azure-key-vault` can use built-in provider executors. `pkcs11-hsm` remains an HTTPS signing-gateway profile.
# Type: choice; processes: API; choices: unset, `local`, `external`, `aws-kms`, `aws_kms`, `gcp-kms`, `gcp_kms`, `azure-key-vault`, `azure_key_vault`, `pkcs11-hsm`, `pkcs11_hsm`; production choices: `external`, `aws-kms`, `aws_kms`, `gcp-kms`, `gcp_kms`, `azure-key-vault`, `azure_key_vault`, `pkcs11-hsm`, `pkcs11_hsm`
EVYDENCE_SIGNING_KEY_MODE=external

# Base64-encoded operator-managed PEM public key, bounded to 1 MiB after decoding. It can be configured with or instead of the trusted root.
# Type: base64; processes: API; decoded bytes <= 1048576
EVYDENCE_SIGSTORE_TRUSTED_PUBLIC_KEY_PEM_BASE64=

# Base64-encoded operator-managed Sigstore trusted-root JSON, bounded to 1 MiB after decoding. Do not put private keys here.
# Type: base64; processes: API; decoded bytes <= 1048576
EVYDENCE_SIGSTORE_TRUST_ROOT_JSON_BASE64=

# Non-secret operator version label recorded in the verification receipt. Missing, malformed, or oversized trust configuration prevents startup.
# Type: text; processes: API; input bytes <= 256
EVYDENCE_SIGSTORE_TRUST_ROOT_VERSION=

# Set to `true` only when migrations are applied by a separate release process. API and worker startup still verify that no committed migrations are pending and fail closed if the database is behind.
# Type: boolean; processes: API, worker, parser replay, reconciliation; schema validation
EVYDENCE_SKIP_MIGRATIONS=false

# Integer `60..43200`, at most the configured maximum lifetime. Cannot be disabled. Captured on new sessions.
# Type: seconds; processes: API; 60..43200 seconds
EVYDENCE_SSO_SESSION_IDLE_TIMEOUT_SECONDS=1800

# Integer `60..43200`; maximum absolute lifetime for newly issued SSO sessions. Explicit expiry beyond the configured limit is rejected.
# Type: seconds; processes: API; 60..43200 seconds
EVYDENCE_SSO_SESSION_MAX_LIFETIME_SECONDS=43200

# Enable the owned optional OTLP/HTTP trace adapter. Disabled creates no exporter and sends no trace traffic. Requires an explicit collector endpoint; no automatic OpenTelemetry environment configuration or incoming baggage is admitted.
# Type: boolean; processes: API, worker; schema validation
EVYDENCE_TRACING_ENABLED=false

# Full HTTPS OTLP/HTTP trace collector URL, normally ending in /v1/traces, required when tracing is enabled. Userinfo, query strings and fragments are rejected. Private collector addresses are permitted as explicit operator configuration; no ambient proxy or authentication headers are used. The collector must support the configured system trust roots.
# Type: url; processes: API, worker; input bytes <= 4096; endpoint policy: tls-base
EVYDENCE_TRACING_ENDPOINT=

# Per-batch trace export timeout, one through five whole seconds, without retries. Best-effort trace shutdown has a separate one-second budget after request/job drain; export or shutdown failure cannot change an application result or consume the critical resource-cleanup budget.
# Type: seconds; processes: API, worker; 1..5 seconds
EVYDENCE_TRACING_EXPORT_TIMEOUT_SECONDS=2

# Maximum completed spans queued in one process: 16 through 1024. A full queue drops diagnostic spans without blocking application work. Batches contain at most 32 spans.
# Type: integer; processes: API, worker; 16..1024
EVYDENCE_TRACING_QUEUE_SIZE=128

# Root trace sampling probability in millionths: 0 through 1000000; the default is 1%. Durable worker children retain the internally sampled parent decision. This controls diagnostic collection, not evidence retention.
# Type: integer; processes: API, worker; 0..1000000
EVYDENCE_TRACING_SAMPLE_PER_MILLION=10000

# Allow HTTP loopback transparency fetch only outside production.
# Type: boolean; processes: API; production-forbidden override
EVYDENCE_TRANSPARENCY_FETCH_ALLOW_INSECURE_LOCALHOST=false

# Direct transparency HTTP fetch timeout in whole seconds.
# Type: seconds; processes: API; 1..9223372036 seconds
EVYDENCE_TRANSPARENCY_FETCH_TIMEOUT_SECONDS=10

# Allows an HTTP loopback transparency gateway only outside production. `ENV=production` rejects this setting when `true`.
# Type: boolean; processes: API; production-forbidden override
EVYDENCE_TRANSPARENCY_PROOF_GATEWAY_ALLOW_INSECURE_LOCALHOST=false

# Timeout for transparency proof gateway requests.
# Type: seconds; processes: API; 1..9223372036 seconds
EVYDENCE_TRANSPARENCY_PROOF_GATEWAY_TIMEOUT_SECONDS=10

# Optional bearer token for the transparency proof gateway. Store outside source control and logs.
# Type: text; processes: API; schema validation
EVYDENCE_TRANSPARENCY_PROOF_GATEWAY_TOKEN=
# Unset EVYDENCE_TRANSPARENCY_PROOF_GATEWAY_TOKEN to use its private-file alternative instead:
# EVYDENCE_TRANSPARENCY_PROOF_GATEWAY_TOKEN_FILE=

# Optional HTTPS operator-controlled gateway for transparency inclusion proof fetch/verification material. When unset, Evydence fetches from the configured public log endpoint.
# Type: url; processes: API; endpoint policy: gateway
EVYDENCE_TRANSPARENCY_PROOF_GATEWAY_URL=

# Comma-separated proxy source CIDRs. Evydence uses `X-Forwarded-For` only when the direct TCP peer is in this list; otherwise it rate-limits the direct remote address.
# Type: cidrs; processes: API; items <= 256
EVYDENCE_TRUSTED_PROXY_CIDRS=

# Maximum outbox jobs claimed per polling cycle.
# Type: integer; processes: worker; 1..9223372036854775807
EVYDENCE_WORKER_BATCH_SIZE=10

# Worker lifecycle listener and healthcheck client address. Must be a literal IPv4/IPv6 loopback address with a nonzero port; remote addresses, hostnames and wildcard binds are rejected before storage opens. Set distinct ports for multiple workers in one network namespace. Helm sets the port through `worker.healthPort`.
# Type: text; processes: worker, worker probe; schema validation
EVYDENCE_WORKER_HEALTH_ADDR=127.0.0.1:8081

# Immutable worker-job byte budget shared by bounded object reads, structured replay parsing and normalized VEX decision inputs; leaves room for the bounded reader's extra sentinel byte.
# Type: integer; processes: worker; 1..9223372036854775806
EVYDENCE_WORKER_MAX_PAYLOAD_BYTES=20971520

# Optional separate `GET/HEAD /metrics` listener. Requires a literal loopback or private IPv4/IPv6 address, nonzero port, no zone and a port/address distinct from the lifecycle listener. Hostnames, public and wildcard binds are rejected before runtime opens. Both metrics variables unset disables the listener. See [worker scraping](observability.md#worker-scraping).
# Type: text; processes: worker; input bytes <= 128
EVYDENCE_WORKER_METRICS_ADDR=

# Absolute path to an operator-owned POSIX regular secret file: exactly `evymetrics_` plus 64 lowercase hexadecimal characters, with one optional final LF. Use mode `0600`, `0640` or `0440`; group write and all other-user permissions are rejected. Relative symlink projections must stay inside the configured parent directory. Only the credential hash is retained; rotation/revocation requires replacing the file and restarting/stopping the worker. API/SSO/tenant credentials are not accepted.
# Type: path; processes: worker; input bytes <= 4096
EVYDENCE_WORKER_METRICS_TOKEN_FILE=

# Optional hardening mode for non-VEX parser-backed uploads. When set to `true`, the API stores accepted records and the outbox worker populates parser-derived fields from tenant-prefixed raw payloads after digest verification. VEX documents are normalized during upload and their decisions are always created post-commit by the worker from a versioned normalized request; a stored raw payload adds independent replay verification.
# Type: boolean; processes: API; schema validation
EVYDENCE_WORKER_OWNED_PARSER_SIDE_EFFECTS=true

# Worker outbox polling interval.
# Type: duration; processes: worker; 1..9223372036854775807 nanoseconds
EVYDENCE_WORKER_POLL_INTERVAL=1s

# Active-job drain and acknowledgement budget after `SIGINT` or `SIGTERM`; whole seconds from 1 through 300. Invalid values reject daemon startup before storage opens.
# Type: seconds; processes: worker; 1..300 seconds
EVYDENCE_WORKER_SHUTDOWN_TIMEOUT_SECONDS=30

# Native SDK/platform inputs keep their separate resolution owners; see the configuration reference.
# END EVYDENCE GENERATED CONFIGURATION

# Telemetry and diagnostics. Evydence exposes authenticated readiness,
# metrics, audit-log, and admin surfaces; configure scraping, log redaction,
# alert routing, and retention in the deployment platform.
# Do not export raw evidence payloads, bearer tokens, database URLs, private
# keys, object-store credentials, provider credentials, or customer package
# contents.
